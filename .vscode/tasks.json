			"command": "JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home PATH=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home/bin:/usr/bin:/bin:/usr/sbin:/sbin /bin/sh ./gradlew test --no-daemon",
			"isBackground": false
